{
    "MONOSCRIPT Function": {
        "prefix": "msfunc",
        "body": [
            "[${1:i32}]${2:functionName}(${3:i32}: ${4:arg})",
            "|   ${0:return 0}"
        ],
        "description": "Define a MONOSCRIPT function"
    },
    "Main Function": {
        "prefix": "main",
        "body": [
            "[i32]main()",
            "|   $0",
            "|   return 0"
        ],
        "description": "Program entry point"
    },
    "Strict Function": {
        "prefix": "sfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @strict",
            "|   $0"
        ],
        "description": "Function without implicit casts"
    },
    "Pure Function": {
        "prefix": "pfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @pure",
            "|   $0"
        ],
        "description": "Function without side effects (checked by the compiler)"
    },
    "Pure Strict Function": {
        "prefix": "psfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @strict @pure",
            "|   $0"
        ],
        "description": "Pure and strict function"
    },
    "Entry Function": {
        "prefix": "efunc",
        "body": [
            "[${1:i32}]${2:start}() @entry",
            "|   $0",
            "|   return 0"
        ],
        "description": "Entry point with a custom name instead of main"
    },
    "Overwrite Function": {
        "prefix": "ofunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @overwrite",
            "|   $0"
        ],
        "description": "Replace an imported function on purpose"
    },
    "Generic Function": {
        "prefix": "gfunc",
        "body": [
            "[${1:T}]${2:first}<${3:T}>(${4:array<T>}: ${5:items})",
            "|   ${0:return items[0]}"
        ],
        "description": "Generic function, the types come from the arguments"
    },
    "Function Parameter": {
        "prefix": "funcp",
        "body": [
            "func: ${1:keep}(${2:T}: ${3:x}) -> ${4:i1}"
        ],
        "description": "Parameter that takes a function by name"
    },
    "Result Function": {
        "prefix": "rfunc",
        "body": [
            "[result<${1:i32}>]${2:functionName}(${3:string}: ${4:s})",
            "|   if ${5:len(s) == 0}",
            "|   |   return err(${6:1}, \"${7:empty input}\")",
            "|   return ok(${0:0})"
        ],
        "description": "Function that returns result<T>"
    },
    "Check Result": {
        "prefix": "ifok",
        "body": [
            "${1:result<i32>} ${2:r} = ${3:call()}",
            "if ?${2:r}",
            "|   ${4:echo(cstr(${2:r}.value))}",
            "else",
            "|   ${0:echo(\"error \" + ${2:r}.code + \": \" + ${2:r}.error)}"
        ],
        "description": "Call a function that returns result<T> and check it"
    },
    "Attempt": {
        "prefix": "attempt",
        "body": [
            "attempt",
            "|   ${1:n ^= toInt(s)?}",
            "else error",
            "|   ${2:echo(error.error)}",
            "panic info",
            "|   ${0:echo(info.message + \" at line \" + info.line)}"
        ],
        "description": "Handle result errors (?) and runtime panics locally"
    },
    "Result Fallback": {
        "prefix": "orelse",
        "body": [
            "${1:value} ^= ${2:toInt(s)}? else ${0:0}"
        ],
        "description": "Unwrap a result or use a replacement value on error"
    },
    "Ignore Result": {
        "prefix": "ignore",
        "body": [
            "_ ^= ${0:call()}"
        ],
        "description": "Ignore a result<T> on purpose"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "[struct]${1:Name}",
            "|   ${2:i32} ${3:field} = ${4:0}",
            "|",
            "|   [${5:void}]${6:method}()",
            "|   |   ${0:self.${3:field} = self.${3:field} + 1}"
        ],
        "description": "Struct with a field and a method"
    },
    "Method": {
        "prefix": "method",
        "body": [
            "[${1:void}]${2:method}(${3})",
            "|   $0"
        ],
        "description": "Method inside a struct, the object is `self`"
    },
    "Constant Declaration": {
        "prefix": "const",
        "body": [
            "const ${1:i32} ${2:NAME} = ${3:value}"
        ],
        "description": "Constant with an explicit type"
    },
    "Final Declaration": {
        "prefix": "final",
        "body": [
            "final ${1:name} ^= ${2:value}"
        ],
        "description": "Constant with an inferred type"
    },
    "Final Deferred": {
        "prefix": "finald",
        "body": [
            "final ${1:i32} ${2:name}"
        ],
        "description": "Constant assigned later, on every path before it is read"
    },
    "Inferred Variable": {
        "prefix": "var",
        "body": [
            "${1:name} ^= ${2:value}"
        ],
        "description": "Variable with an inferred type"
    },
    "Array Variable": {
        "prefix": "arr",
        "body": [
            "array<${1:i32}> ${2:name} = [${3}]"
        ],
        "description": "Typed array variable"
    },
    "Map Variable": {
        "prefix": "mapv",
        "body": [
            "map<${1:string}, ${2:i32}> ${3:name} = {${4}}"
        ],
        "description": "Typed map variable"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if ${1:condition}",
            "|   $0"
        ],
        "description": "If statement"
    },
    "If-Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if ${1:condition}",
            "|   $2",
            "else",
            "|   $0"
        ],
        "description": "If-else statement"
    },
    "If-Else If-Else Statement": {
        "prefix": "ifelseif",
        "body": [
            "if ${1:condition1}",
            "|   $2",
            "else if ${3:condition2}",
            "|   $4",
            "else",
            "|   $0"
        ],
        "description": "If-else if-else statement"
    },
    "For Range": {
        "prefix": "for",
        "body": [
            "for ${1:i} in range(${2:n})",
            "|   $0"
        ],
        "description": "Loop from 0 to n - 1"
    },
    "For Range From To": {
        "prefix": "forr",
        "body": [
            "for ${1:i} in range(${2:a}, ${3:b})",
            "|   $0"
        ],
        "description": "Loop from a to b - 1"
    },
    "For Each": {
        "prefix": "forin",
        "body": [
            "for ${1:x} in ${2:items}",
            "|   $0"
        ],
        "description": "Loop over an array, the keys of a map or the bytes of a string"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while ${1:condition}",
            "|   $0"
        ],
        "description": "While loop"
    },
    "Use Modules": {
        "prefix": "use",
        "body": [
            "use",
            "|> ${1:module}$0"
        ],
        "description": "Import modules"
    },
    "Use Function With Alias": {
        "prefix": "usefn",
        "body": [
            "|> ${1:module} -> ${2:function} : ${3:alias}"
        ],
        "description": "Import a function from a module under an alias"
    },
    "Return Statement": {
        "prefix": "return",
        "body": [
            "return $0"
        ],
        "description": "Return statement"
    },
    "Echo Statement": {
        "prefix": "echo",
        "body": [
            "echo(${0:value})"
        ],
        "description": "Print a string"
    },
    "Echo Value": {
        "prefix": "echoi",
        "body": [
            "echo(cstr(${0:value}))"
        ],
        "description": "Print a number or char"
    },
    "MONOSCRIPT Block": {
        "prefix": "pipeblock",
        "body": [
            "|   $0"
        ],
        "description": "Insert a MONOSCRIPT indented block"
    }
}
