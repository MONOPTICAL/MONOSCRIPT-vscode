{
    "MONOSCRIPT Function": {
        "prefix": "msfunc",
        "body": [
            "[${1:i32}]${2:functionName}(${3:i32}: ${4:arg})",
            "|   ${0:return 0}"
        ],
        "description": "Define a MONOSCRIPT function"
    },
    "Main Function": {
        "prefix": "main",
        "body": [
            "[i32]main() @entry",
            "|   $0",
            "|   return 0"
        ],
        "description": "Main function template"
    },
    "Strict Function": {
        "prefix": "sfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @strict",
            "|   $0"
        ],
        "description": "Define a strict MONOSCRIPT function"
    },
    "Pure Function": {
        "prefix": "pfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @pure",
            "|   $0"
        ],
        "description": "Define a pure MONOSCRIPT function"
    },
    "Entry Function": {
        "prefix": "efunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @entry",
            "|   $0"
        ],
        "description": "Define an entry-point MONOSCRIPT function"
    },
    "Pure Strict Function": {
        "prefix": "psfunc",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @strict @pure",
            "|   $0"
        ],
        "description": "Define a pure and strict MONOSCRIPT function"
    },
    "Declaration Only": {
        "prefix": "decl",
        "body": [
            "[${1:void}]${2:functionName}(${3}) @decl$0"
        ],
        "description": "Function declaration without a body"
    },
    "Struct": {
        "prefix": "struct",
        "body": [
            "[struct]${1:Name}",
            "|   ${2:i32} ${3:field} = ${4:0}",
            "|",
            "|   [void]__init__(${5:i32}: ${6:value})",
            "|   |   ${3:field} = ${6:value}$0"
        ],
        "description": "Struct with a field and constructor"
    },
    "Constructor": {
        "prefix": "init",
        "body": [
            "[void]__init__(${1})",
            "|   $0"
        ],
        "description": "Struct constructor (__init__)"
    },
    "Method Outside Struct": {
        "prefix": "method",
        "body": [
            "[${1:void}]${2:Struct}::${3:method}(${4})",
            "|   $0"
        ],
        "description": "Function associated with a struct (Struct::method)"
    },
    "Constant Declaration": {
        "prefix": "const",
        "body": [
            "const ${1:i32} ${2:NAME} = ${3:value}"
        ],
        "description": "Declare a constant with an explicit type"
    },
    "Final Declaration": {
        "prefix": "final",
        "body": [
            "final ${1:name} ^= ${2:value}"
        ],
        "description": "Declare a constant with an inferred type"
    },
    "Inferred Variable": {
        "prefix": "var",
        "body": [
            "${1:name} ^= ${2:value}"
        ],
        "description": "Variable with an inferred type"
    },
    "Array Variable": {
        "prefix": "arr",
        "body": [
            "array<${1:i32}> ${2:name} = [${3}]"
        ],
        "description": "Typed array variable"
    },
    "Map Variable": {
        "prefix": "mapv",
        "body": [
            "map<${1:string}, ${2:string}> ${3:name} = {${4}}"
        ],
        "description": "Typed map variable"
    },
    "If Statement": {
        "prefix": "if",
        "body": [
            "if (${1:condition})",
            "|   $0"
        ],
        "description": "If statement"
    },
    "If-Else Statement": {
        "prefix": "ifelse",
        "body": [
            "if (${1:condition})",
            "|   $2",
            "else",
            "|   $0"
        ],
        "description": "If-else statement"
    },
    "If-Else If-Else Statement": {
        "prefix": "ifelseif",
        "body": [
            "if (${1:condition1})",
            "|   $2",
            "else if (${3:condition2})",
            "|   $4",
            "else",
            "|   $0"
        ],
        "description": "If-else if-else statement"
    },
    "For Loop": {
        "prefix": "for",
        "body": [
            "for ${1:i} in range(${2:array})",
            "|   $0"
        ],
        "description": "For loop over array indices"
    },
    "While Loop": {
        "prefix": "while",
        "body": [
            "while (${1:condition})",
            "|   $0"
        ],
        "description": "While loop"
    },
    "Lambda": {
        "prefix": "lambda",
        "body": [
            "${1:name} ^= [${2:i32}](${3:i32}: ${4:x}) -> ${0:x}"
        ],
        "description": "One-line lambda"
    },
    "Block Lambda": {
        "prefix": "lambdab",
        "body": [
            "${1:name} ^= [${2:i32}](${3:i32}: ${4:x}) :",
            "|   ${0:return x}"
        ],
        "description": "Multi-line lambda"
    },
    "Use Modules": {
        "prefix": "use",
        "body": [
            "use",
            "|> ${1:module}$0"
        ],
        "description": "Import modules"
    },
    "Use Function With Alias": {
        "prefix": "usefn",
        "body": [
            "|> ${1:module} -> ${2:function} : ${3:alias}"
        ],
        "description": "Import a function from a module under an alias"
    },
    "Pipe": {
        "prefix": "pipe",
        "body": [
            "|> ${1:map}(${2:x}, [${3:i32}](${4:i32}: ${5:a}) -> ${0:a})"
        ],
        "description": "Pipe step with a lambda"
    },
    "Return Statement": {
        "prefix": "return",
        "body": [
            "return $0"
        ],
        "description": "Return statement"
    },
    "Echo Statement": {
        "prefix": "echo",
        "body": [
            "echo(${0:value})"
        ],
        "description": "Echo statement"
    },
    "Echo Integer": {
        "prefix": "echoi",
        "body": [
            "echo(toString_int(${0:value}))"
        ],
        "description": "Print an i32 value"
    },
    "MONOSCRIPT Block": {
        "prefix": "pipeblock",
        "body": [
            "|   $0"
        ],
        "description": "Insert a MONOSCRIPT indented block"
    }
}
