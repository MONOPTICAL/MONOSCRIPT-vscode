{
    "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name": "MONOSCRIPT",
    "scopeName": "source.ms",
    "fileTypes": [
        "ms"
    ],
    "patterns": [
        {
            "include": "#comments"
        },
        {
            "include": "#block-guides"
        },
        {
            "include": "#import"
        },
        {
            "include": "#struct-declaration"
        },
        {
            "include": "#function-declaration"
        },
        {
            "include": "#statements"
        }
    ],
    "repository": {
        "comments": {
            "patterns": [
                {
                    "name": "comment.block.ms",
                    "begin": "/\\*",
                    "end": "\\*/",
                    "captures": {
                        "0": {
                            "name": "punctuation.definition.comment.ms"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comment-tags"
                        }
                    ]
                },
                {
                    "name": "comment.line.double-slash.ms",
                    "begin": "//",
                    "end": "$",
                    "beginCaptures": {
                        "0": {
                            "name": "punctuation.definition.comment.ms"
                        }
                    },
                    "patterns": [
                        {
                            "include": "#comment-tags"
                        }
                    ]
                }
            ]
        },
        "comment-tags": {
            "match": "\\b(TODO|FIXME|HACK|NOTE|XXX)\\b",
            "name": "keyword.other.todo.ms"
        },
        "block-guides": {
            "match": "^[ \\t]*((?:\\|(?!>)[ \\t]*)+)",
            "captures": {
                "1": {
                    "name": "punctuation.section.block.ms"
                }
            }
        },
        "import": {
            "patterns": [
                {
                    "match": "\\b(use)\\b",
                    "name": "keyword.control.import.ms"
                },
                {
                    "match": "(?:^|(?<=\\buse))[ \\t]*(\\|>)[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?:(->)[ \\t]*([A-Za-z_][A-Za-z0-9_]*)[ \\t]*(?:(:)[ \\t]*([A-Za-z_][A-Za-z0-9_]*))?)?[ \\t]*(?=$|//)",
                    "captures": {
                        "1": {
                            "name": "keyword.operator.pipe.ms"
                        },
                        "2": {
                            "name": "entity.name.namespace.ms"
                        },
                        "3": {
                            "name": "keyword.operator.arrow.ms"
                        },
                        "4": {
                            "name": "entity.name.function.ms"
                        },
                        "5": {
                            "name": "punctuation.separator.alias.ms"
                        },
                        "6": {
                            "name": "entity.name.function.alias.ms"
                        }
                    }
                }
            ]
        },
        "struct-declaration": {
            "match": "(\\[)\\s*(struct)\\s*(\\])\\s*([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "punctuation.definition.type.begin.ms"
                },
                "2": {
                    "name": "storage.type.struct.ms"
                },
                "3": {
                    "name": "punctuation.definition.type.end.ms"
                },
                "4": {
                    "name": "entity.name.type.struct.ms"
                }
            }
        },
        "function-declaration": {
            "name": "meta.function.ms",
            "begin": "(\\[)\\s*([A-Za-z_][A-Za-z0-9_]*(?:<(?:[\\w\\s,]|<(?:[\\w\\s,]|<[\\w\\s,]*>)*>)*>)?)\\s*(\\])\\s*([A-Za-z_][A-Za-z0-9_]*)\\s*(?:(<)([\\w\\s,]*)(>))?\\s*(\\()",
            "beginCaptures": {
                "1": {
                    "name": "punctuation.definition.type.begin.ms"
                },
                "2": {
                    "patterns": [
                        {
                            "include": "#type-expression"
                        }
                    ]
                },
                "3": {
                    "name": "punctuation.definition.type.end.ms"
                },
                "4": {
                    "name": "entity.name.function.ms"
                },
                "5": {
                    "name": "punctuation.definition.typeparameters.begin.ms"
                },
                "6": {
                    "patterns": [
                        {
                            "include": "#type-parameters"
                        }
                    ]
                },
                "7": {
                    "name": "punctuation.definition.typeparameters.end.ms"
                },
                "8": {
                    "name": "punctuation.definition.parameters.begin.ms"
                }
            },
            "end": "\\)",
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.parameters.end.ms"
                }
            },
            "patterns": [
                {
                    "include": "#parameters"
                }
            ]
        },
        "type-parameters": {
            "patterns": [
                {
                    "match": "[A-Za-z_][A-Za-z0-9_]*",
                    "name": "entity.name.type.parameter.ms"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.ms"
                }
            ]
        },
        "parameters": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "match": "\\b(func)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)?",
                    "captures": {
                        "1": {
                            "name": "storage.type.ms"
                        },
                        "2": {
                            "name": "punctuation.separator.parameter.ms"
                        },
                        "3": {
                            "name": "variable.parameter.function.ms"
                        }
                    }
                },
                {
                    "match": "([A-Za-z_][A-Za-z0-9_]*(?:<(?:[\\w\\s,]|<(?:[\\w\\s,]|<[\\w\\s,]*>)*>)*>)?)\\s*(:)\\s*([A-Za-z_][A-Za-z0-9_]*)",
                    "captures": {
                        "1": {
                            "patterns": [
                                {
                                    "include": "#type-expression"
                                }
                            ]
                        },
                        "2": {
                            "name": "punctuation.separator.parameter.ms"
                        },
                        "3": {
                            "name": "variable.parameter.ms"
                        }
                    }
                },
                {
                    "begin": "\\(",
                    "end": "\\)",
                    "patterns": [
                        {
                            "include": "#parameters"
                        }
                    ]
                },
                {
                    "match": "->",
                    "name": "keyword.operator.arrow.ms"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.ms"
                },
                {
                    "include": "#type-expression"
                }
            ]
        },
        "type-expression": {
            "patterns": [
                {
                    "match": "\\b(i1|i8|i16|i32|i64|float|f64|char|string|void|auto|panic_info)\\b",
                    "name": "storage.type.primitive.ms"
                },
                {
                    "match": "\\b(array|map|func|result)\\b",
                    "name": "storage.type.generic.ms"
                },
                {
                    "match": "\\bstruct\\b",
                    "name": "storage.type.struct.ms"
                },
                {
                    "match": "<",
                    "name": "punctuation.definition.generic.begin.ms"
                },
                {
                    "match": ">",
                    "name": "punctuation.definition.generic.end.ms"
                },
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.ms"
                },
                {
                    "match": "[A-Za-z_][A-Za-z0-9_]*",
                    "name": "entity.name.type.ms"
                }
            ]
        },
        "statements": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#labels"
                },
                {
                    "include": "#for-loop"
                },
                {
                    "include": "#declarations"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#cast"
                },
                {
                    "include": "#expressions"
                }
            ]
        },
        "labels": {
            "patterns": [
                {
                    "match": "(@)(strict|pure|entry|public|private|test|overwrite)\\b",
                    "captures": {
                        "0": {
                            "name": "storage.modifier.label.ms"
                        },
                        "1": {
                            "name": "punctuation.definition.label.ms"
                        }
                    }
                },
                {
                    "match": "(@)[A-Za-z_][A-Za-z0-9_]*",
                    "name": "invalid.deprecated.label.unknown.ms",
                    "captures": {
                        "1": {
                            "name": "punctuation.definition.label.ms"
                        }
                    }
                }
            ]
        },
        "for-loop": {
            "match": "\\b(for)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(in)\\b",
            "captures": {
                "1": {
                    "name": "keyword.control.loop.ms"
                },
                "2": {
                    "name": "variable.other.loop.ms"
                },
                "3": {
                    "name": "keyword.control.loop.ms"
                }
            }
        },
        "declarations": {
            "patterns": [
                {
                    "match": "(?:\\b(const|final)\\s+)?(?<![.\\w])(?!(?:if|else|attempt|panic|while|for|in|return|break|continue|and|or|is|use|const|final|public|private|this|self|defined|true|false|null|none|struct)\\b)([A-Za-z_][A-Za-z0-9_]*(?:<(?:[\\w\\s,]|<(?:[\\w\\s,]|<[\\w\\s,]*>)*>)*>)?)\\s+(?!(?:if|else|attempt|panic|while|for|in|return|break|continue|and|or|is|use|const|final|public|private|this|self|defined|true|false|null|none|struct)\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=$|//|=(?!=))",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.ms"
                        },
                        "2": {
                            "patterns": [
                                {
                                    "include": "#type-expression"
                                }
                            ]
                        },
                        "3": {
                            "name": "variable.other.declaration.ms"
                        }
                    }
                },
                {
                    "match": "(?:\\b(final)\\s+)?(?<![.\\w])([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\^=)",
                    "captures": {
                        "1": {
                            "name": "storage.modifier.ms"
                        },
                        "2": {
                            "name": "variable.other.declaration.ms"
                        }
                    }
                }
            ]
        },
        "keywords": {
            "patterns": [
                {
                    "match": "\\b(else|panic)\\s+(?!if\\b)([A-Za-z_][A-Za-z0-9_]*)\\s*(?=$|//)",
                    "captures": {
                        "1": {
                            "name": "keyword.control.exception.ms"
                        },
                        "2": {
                            "name": "variable.parameter.handler.ms"
                        }
                    }
                },
                {
                    "match": "\\b(attempt|panic)\\b",
                    "name": "keyword.control.exception.ms"
                },
                {
                    "match": "\\b(if|else)\\b",
                    "name": "keyword.control.conditional.ms"
                },
                {
                    "match": "\\b(while|for|in)\\b",
                    "name": "keyword.control.loop.ms"
                },
                {
                    "match": "\\b(return|break|continue)\\b",
                    "name": "keyword.control.flow.ms"
                },
                {
                    "match": "\\b(and|or|is)\\b",
                    "name": "keyword.operator.logical.ms"
                },
                {
                    "match": "\\b(defined)\\b",
                    "name": "keyword.operator.defined.ms"
                },
                {
                    "match": "\\b(const|final|public|private)\\b",
                    "name": "storage.modifier.ms"
                },
                {
                    "match": "\\b(self|this)\\b",
                    "name": "variable.language.self.ms"
                },
                {
                    "match": "(?<![\\w.])_(?![\\w])",
                    "name": "variable.language.discard.ms"
                }
            ]
        },
        "cast": {
            "match": "(->)\\s*\\b(i1|i8|i16|i32|i64|float|f64|char)\\b",
            "captures": {
                "1": {
                    "name": "keyword.operator.cast.ms"
                },
                "2": {
                    "name": "storage.type.primitive.ms"
                }
            }
        },
        "expressions": {
            "patterns": [
                {
                    "include": "#comments"
                },
                {
                    "include": "#strings"
                },
                {
                    "include": "#chars"
                },
                {
                    "include": "#numbers"
                },
                {
                    "include": "#constants"
                },
                {
                    "include": "#keywords"
                },
                {
                    "include": "#cast"
                },
                {
                    "include": "#function-call"
                },
                {
                    "include": "#type-expression-standalone"
                },
                {
                    "include": "#member-access"
                },
                {
                    "include": "#operators"
                },
                {
                    "include": "#punctuation"
                }
            ]
        },
        "strings": {
            "name": "string.quoted.double.ms",
            "begin": "\"",
            "end": "\"|$",
            "beginCaptures": {
                "0": {
                    "name": "punctuation.definition.string.begin.ms"
                }
            },
            "endCaptures": {
                "0": {
                    "name": "punctuation.definition.string.end.ms"
                }
            },
            "patterns": [
                {
                    "match": "\\\\[nrtfb0'\"\\\\]",
                    "name": "constant.character.escape.ms"
                },
                {
                    "match": "\\\\.",
                    "name": "invalid.illegal.escape.ms"
                }
            ]
        },
        "chars": {
            "patterns": [
                {
                    "match": "(')(?:(\\\\[nrtfb0'\"\\\\])|([^'\\\\]))(')",
                    "captures": {
                        "0": {
                            "name": "string.quoted.single.ms"
                        },
                        "1": {
                            "name": "punctuation.definition.string.begin.ms"
                        },
                        "2": {
                            "name": "constant.character.escape.ms"
                        },
                        "3": {
                            "name": "constant.character.ms"
                        },
                        "4": {
                            "name": "punctuation.definition.string.end.ms"
                        }
                    }
                },
                {
                    "match": "'(?:\\\\.|[^'\\\\])*'?",
                    "name": "invalid.illegal.character.ms"
                }
            ]
        },
        "numbers": {
            "patterns": [
                {
                    "match": "(?<![\\w.])\\d+\\.\\d*(?:[eE][+-]?\\d+)?\\b|(?<![\\w.])\\.\\d+\\b",
                    "name": "constant.numeric.float.ms"
                },
                {
                    "match": "(?<![\\w.])0[xX][0-9A-Fa-f]+\\b",
                    "name": "constant.numeric.hex.ms"
                },
                {
                    "match": "(?<![\\w.])\\d+\\b",
                    "name": "constant.numeric.integer.ms"
                }
            ]
        },
        "constants": {
            "patterns": [
                {
                    "match": "\\b(true|false)\\b",
                    "name": "constant.language.boolean.ms"
                },
                {
                    "match": "\\b(null|none)\\b",
                    "name": "constant.language.null.ms"
                }
            ]
        },
        "function-call": {
            "patterns": [
                {
                    "match": "\\b(echo|input|scat|substr|strfind|startsWith|count|split|reverse|toInt|toString_int|toString_char|toString_bool|toString_float|toString_f64|toString_long|toArray|joinChars|gc_collect|len|has|del|copy|push|pop|ok|err|range|cstr)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "support.function.builtin.ms"
                        }
                    }
                },
                {
                    "match": "(?<![.\\w])([A-Z][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "entity.name.type.struct.ms"
                        }
                    }
                },
                {
                    "match": "(?:(\\.)\\s*)?\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()",
                    "captures": {
                        "1": {
                            "name": "punctuation.accessor.ms"
                        },
                        "2": {
                            "name": "entity.name.function.call.ms"
                        }
                    }
                }
            ]
        },
        "type-expression-standalone": {
            "patterns": [
                {
                    "match": "\\b(i1|i8|i16|i32|i64|float|f64|char|string|void|auto|panic_info)\\b",
                    "name": "storage.type.primitive.ms"
                },
                {
                    "match": "\\b(array|map|func|result)\\b(?=\\s*<)",
                    "name": "storage.type.generic.ms"
                }
            ]
        },
        "member-access": {
            "match": "(\\.)\\s*([A-Za-z_][A-Za-z0-9_]*)",
            "captures": {
                "1": {
                    "name": "punctuation.accessor.ms"
                },
                "2": {
                    "name": "variable.other.property.ms"
                }
            }
        },
        "operators": {
            "patterns": [
                {
                    "match": "\\|>",
                    "name": "keyword.operator.pipe.ms"
                },
                {
                    "match": "->",
                    "name": "keyword.operator.arrow.ms"
                },
                {
                    "match": "\\^=",
                    "name": "keyword.operator.assignment.inferred.ms"
                },
                {
                    "match": "==|!=|<=|>=",
                    "name": "keyword.operator.comparison.ms"
                },
                {
                    "match": "=",
                    "name": "keyword.operator.assignment.ms"
                },
                {
                    "match": "\\*\\*|[+\\-*/%]",
                    "name": "keyword.operator.arithmetic.ms"
                },
                {
                    "match": "<|>",
                    "name": "keyword.operator.comparison.ms"
                },
                {
                    "match": "!",
                    "name": "keyword.operator.logical.ms"
                },
                {
                    "match": "(?<=[\\w)\\]])\\?+",
                    "name": "keyword.operator.result-try.ms"
                },
                {
                    "match": "\\?(?=\\s*[\\w(])",
                    "name": "keyword.operator.result-check.ms"
                }
            ]
        },
        "punctuation": {
            "patterns": [
                {
                    "match": ",",
                    "name": "punctuation.separator.comma.ms"
                },
                {
                    "match": ":",
                    "name": "punctuation.separator.colon.ms"
                },
                {
                    "match": ";",
                    "name": "punctuation.terminator.ms"
                },
                {
                    "match": "[()\\[\\]{}]",
                    "name": "meta.brace.ms"
                },
                {
                    "match": "[A-Za-z_][A-Za-z0-9_]*",
                    "name": "variable.other.ms"
                }
            ]
        }
    }
}
