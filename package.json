{
  "name": "monoscript-language-support",
  "displayName": "MONOSCRIPT(MONOPTICAL) Language Support",
  "description": "MONOSCRIPT language support with a language server: syntax highlighting, smart | indentation, diagnostics while typing, completion, hover, go to definition, rename, inlay type hints and run/compile commands.",
  "version": "0.3.0",
  "publisher": "MONOPTICAL",
  "license": "SEE LICENSE IN LICENSE",
  "icon": "images/icon.png",
  "engines": {
    "vscode": "^1.99.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Formatters"
  ],
  "keywords": [
    "monoscript",
    "monoptical",
    "ms"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/MONOPTICAL/MONOSCRIPT-vscode"
  },
  "scripts": {
    "vscode:prepublish": "npm run grammar && npm run compile",
    "grammar": "node syntaxes/build-grammar.js",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "package": "npx --yes @vscode/vsce@3.2.1 package",
    "test": "npm run compile && node --test test/",
    "build": "npm run grammar && npm run compile"
  },
  "devDependencies": {
    "@types/markdown-it": "14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.99.0",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.0.0",
    "typescript": "^5.0.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onLanguage:ms",
    "workspaceContains:**/*.ms"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ms",
        "aliases": [
          "MONOSCRIPT",
          "ms"
        ],
        "extensions": [
          ".ms"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./images/logo.svg",
          "dark": "./images/logo.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "ms",
        "scopeName": "source.ms",
        "path": "./syntaxes/ms.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "ms-icons",
        "label": "MONOSCRIPT Icons",
        "path": "./ms.icon-theme.json"
      }
    ],
    "configuration": {
      "title": "MONOSCRIPT",
      "properties": {
        "monoscript.compilerPath": {
          "type": "string",
          "default": "ms",
          "markdownDescription": "Путь к компилятору MONOSCRIPT (`ms`). Используется для проверки ошибок, запуска и компиляции."
        },
        "monoscript.diagnostics.enable": {
          "type": "boolean",
          "default": true,
          "description": "Проверять .ms файлы компилятором при открытии и сохранении."
        },
        "monoscript.diagnostics.lint": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Быстрые проверки языкового сервера во время набора: отступы `|`, метки, незакрытые строки, неизвестные функции. Работают без компилятора."
        },
        "monoscript.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Сохранять файл перед запуском и компиляцией."
        },
        "monoscript.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Дополнительные флаги компилятора для запуска и компиляции, например `[\"--timings\"]` или `[\"--offOptimization\"]`."
        },
        "monoscript.indentUnit": {
          "type": "string",
          "default": "|   ",
          "pattern": "^\\| *$",
          "markdownDescription": "Один уровень отступа: `|` и пробелы. По умолчанию `\"|   \"`."
        },
        "monoscript.smartIndent": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Умные `Enter` / `Backspace`: автоматически продолжать и открывать блоки `|`."
        },
        "monoscript.blockGuides": {
          "type": "string",
          "enum": [
            "rainbow",
            "dim",
            "off"
          ],
          "enumDescriptions": [
            "Раскрашивать `|` по уровню вложенности",
            "Приглушать `|`",
            "Без подсветки"
          ],
          "default": "rainbow",
          "description": "Подсветка вертикальных черт отступа."
        },
        "monoscript.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Журнал обмена с языковым сервером (окно Output → MONOSCRIPT Language Server)."
        },
        "monoscript.guide.language": {
          "type": "string",
          "enum": [
            "auto",
            "ru",
            "en"
          ],
          "default": "auto",
          "enumDescriptions": [
            "Как язык интерфейса VS Code",
            "Русский",
            "English"
          ],
          "description": "Язык справочника по MONOSCRIPT."
        }
      }
    },
    "configurationDefaults": {
      "[ms]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
        "editor.detectIndentation": false,
        "editor.guides.indentation": false
      }
    },
    "commands": [
      {
        "command": "monoscript.run",
        "title": "Run File",
        "category": "MONOSCRIPT",
        "icon": "$(play)"
      },
      {
        "command": "monoscript.compile",
        "title": "Compile to Executable",
        "category": "MONOSCRIPT",
        "icon": "$(package)"
      },
      {
        "command": "monoscript.check",
        "title": "Check File",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.showTokens",
        "title": "Show Tokens",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.showAST",
        "title": "Show AST",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.showSemantic",
        "title": "Show Semantic Analysis",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.indentLines",
        "title": "Indent Lines (add |)",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.outdentLines",
        "title": "Outdent Lines (remove |)",
        "category": "MONOSCRIPT"
      },
      {
        "command": "ms.customEnter",
        "title": "Smart Enter",
        "category": "MONOSCRIPT"
      },
      {
        "command": "ms.customBackspace",
        "title": "Smart Backspace",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.openGuide",
        "title": "Open Language Reference",
        "category": "MONOSCRIPT",
        "icon": "$(book)"
      },
      {
        "command": "monoscript.restartServer",
        "title": "Restart Language Server",
        "category": "MONOSCRIPT"
      },
      {
        "command": "monoscript.searchGuide",
        "title": "Search Language Reference",
        "category": "MONOSCRIPT",
        "icon": "$(search)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "monoscript.run",
          "when": "resourceLangId == ms",
          "group": "navigation@0"
        },
        {
          "command": "monoscript.compile",
          "when": "resourceLangId == ms",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "monoscript.run",
          "when": "editorLangId == ms",
          "group": "monoscript@1"
        },
        {
          "command": "monoscript.compile",
          "when": "editorLangId == ms",
          "group": "monoscript@2"
        },
        {
          "command": "monoscript.openGuide",
          "when": "editorLangId == ms",
          "group": "monoscript@9"
        }
      ],
      "commandPalette": [
        {
          "command": "monoscript.run",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.compile",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.check",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.showTokens",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.showAST",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.showSemantic",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.indentLines",
          "when": "editorLangId == ms"
        },
        {
          "command": "monoscript.outdentLines",
          "when": "editorLangId == ms"
        },
        {
          "command": "ms.customEnter",
          "when": "false"
        },
        {
          "command": "ms.customBackspace",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "monoscript.openGuide",
          "when": "resourceLangId == ms",
          "group": "navigation@9"
        }
      ]
    },
    "keybindings": [
      {
        "command": "ms.customEnter",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == ms && !editorReadOnly && config.monoscript.smartIndent && !suggestWidgetVisible && !renameInputVisible && !quickFixWidgetVisible && !inSnippetMode"
      },
      {
        "command": "ms.customBackspace",
        "key": "backspace",
        "when": "editorTextFocus && editorLangId == ms && !editorReadOnly && config.monoscript.smartIndent && !suggestWidgetVisible && !renameInputVisible && !inSnippetMode && !quickFixWidgetVisible"
      },
      {
        "command": "monoscript.indentLines",
        "key": "ctrl+]",
        "mac": "cmd+]",
        "when": "editorTextFocus && editorLangId == ms && !editorReadOnly"
      },
      {
        "command": "monoscript.outdentLines",
        "key": "ctrl+[",
        "mac": "cmd+[",
        "when": "editorTextFocus && editorLangId == ms && !editorReadOnly"
      },
      {
        "command": "monoscript.outdentLines",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == ms && !editorReadOnly && !inSnippetMode && !suggestWidgetVisible && !inlineSuggestionVisible"
      },
      {
        "command": "monoscript.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == ms"
      }
    ],
    "taskDefinitions": [
      {
        "type": "monoscript",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "run",
              "compile",
              "check",
              "tokens",
              "ast",
              "semantic"
            ],
            "description": "Что сделать с файлом."
          },
          "file": {
            "type": "string",
            "description": "Путь к .ms файлу (по умолчанию — активный редактор)."
          },
          "output": {
            "type": "string",
            "description": "Имя исполняемого файла для action = compile."
          }
        }
      }
    ]
  },
  "dependencies": {
    "markdown-it": "14.1.0",
    "vscode-languageclient": "9.0.1",
    "vscode-languageserver": "9.0.1",
    "vscode-languageserver-textdocument": "1.0.12",
    "vscode-uri": "3.0.8"
  }
}
